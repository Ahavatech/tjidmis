 "structure": {
  "page": "div.pkp_structure_page",
  "header": "header.pkp_structure_head#headerNavigationContainer > div.pkp_head_wrapper",
  "skip_links": "nav.cmp_skip_to_content (5 links: main, nav, about, current issue, footer)",
  "logo": "div.pkp_site_name_wrapper > button.pkp_site_nav_toggle + h1.pkp_screen_reader + div.pkp_site_name > a.is_img > img",
  "nav": "nav.pkp_site_nav_menu > div.pkp_navigation_primary_row > div.pkp_navigation_primary_wrapper > ul#navigationPrimary.pkp_navigation_primary.pkp_nav_list (nested ul = dropdown) + div.pkp_navigation_search_wrapper > a.pkp_search",
  "user_nav": "div.pkp_navigation_user_wrapper > ul#navigationUser.pkp_navigation_user.pkp_nav_list > li.profile",
  "content": "div.pkp_structure_content.has_sidebar > div.pkp_structure_main[role=main] + div.pkp_structure_sidebar.left",
  "sidebar_block": "div.pkp_block.block_custom#customblock-* | .block_information | .block_web_feed > h2.title + div.content",
  "home": "div.page_index_journal > div.homepage_image, section.homepage_about, section.current_issue",
  "issue_toc": "div.obj_issue_toc > div.heading + div.sections > div.section > h3 + ul.cmp_article_list.articles > li > div.obj_article_summary (h4.title, div.meta > div.authors + div.pages, ul.galleys_links > li > a.obj_galley_link.pdf)",
  "footer": "div.pkp_structure_footer_wrapper[role=contentinfo] > div.pkp_structure_footer > div.pkp_footer_content + div.pkp_brand_footer"
 },
